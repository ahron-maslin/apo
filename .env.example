# apo's settings. Each can also be set in the environment, which wins over the file.
# `apo init` writes the ones it asks about into ~/.config/apo/config.env on Linux
# (~/Library/Application Support/apo/config.env on macOS); put others there too.

# Linear is optional. Settings -> Connect in the dashboard checks a key and stores it
# encrypted, which is the better way; these are for anyone who'd rather not use the UI.
# APO_LINEAR_API_KEY=
# A team key (e.g. ENG) or team id:
# APO_LINEAR_TEAM=
# APO_POLL_SECONDS=30

# Bring the dashboard up whenever a Claude Code session starts and it's down.
# APO_DASHBOARD_AUTOSTART=1
# APO_DASHBOARD_PORT=8430

# Where your projects live; New project offers its subfolders.
# APO_PROJECTS_ROOT=~/projects

# Block every call to Linear, for scratch scripts and experiments.
# APO_OFFLINE=1
