# Optional, and no longer the primary way to connect Linear — Settings -> Connect in
# the dashboard validates a key live and stores it encrypted. These remain a fallback
# for anyone who'd rather not touch the UI; omit entirely to run without Linear
# (dashboard-only answers still work).
LINEAR_API_KEY=
LINEAR_TEAM=       # team key (e.g. "ENG") or team id
LINEAR_POLL_SECONDS=30

# Bring the dashboard up whenever a Claude Code session starts and it's down.
# ADO_DASHBOARD_AUTOSTART=1
# ADO_DASHBOARD_PORT=8430
